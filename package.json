{
  "name": "web-doctor-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Web Doctor \u2014 a visual debugging workspace for websites.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "demo": "pnpm --filter @webdoctor/demo-site start",
    "webdoctor": "tsx apps/cli/src/main.ts",
    "docs:capture": "pnpm --filter @webdoctor/cli run docs:capture"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
