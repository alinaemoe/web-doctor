  "scenarios": [
    {
      "id": "flaky-down",
      "description": "A page that was checked successfully in run 1 is unreachable in run 2. Its issues must not become Fixed.",
      "steps": ["POST /__demo/flaky/down"],
      "expect": "/flaky is reported as unverified (503); no issue is marked fixed because of this page."
    },
    {
      "id": "verify-fix",
      "description": "Switching the site from broken to fixed and re-verifying single issues.",
      "steps": ["POST /__demo/mode/fixed"],
      "expect": "Re-verifying any broken-mode issue yields 'Verified fixed' (except external 429)."
    }
  ]
